{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD025": false, // Pages use multiple top-level headings. Their titles come from front matter.
    "MD029": false, // Pages use non-continuous ordered-list numbering.
    "MD030": false,
    "MD033": false,
    "MD034": false, // Shortcodes use bare URLs.
  },
  "ignores": [
    "node_modules",
    "CHANGELOG.md",
    "docs/.vitepress/**",
    "docs/public/**",
  ],
}
